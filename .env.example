# ---------------------------------------------------------------------------
# Templo Místico CRM — Variables de entorno
# Copia este archivo a .env.local (dev) o cargalo en Vercel (Settings → Environment).
# NUNCA subas .env* al repo. Ya no hay URLs ni llaves incrustadas en el código.
# ---------------------------------------------------------------------------

# === Supabase (OBLIGATORIO) ===
# URL del proyecto: Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# anon key: Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=AQUI_SUPABASE_ANON_KEY
# service role (SOLO servidor / backend, nunca exponerla en el cliente)
SUPABASE_SERVICE_ROLE_KEY=AQUI_SUPABASE_SERVICE_ROLE_KEY

# === Chatwoot ===
CHATWOOT_URL=https://TU-CHATWOOT.duckdns.org
CHATWOOT_API_TOKEN=AQUI_CHATWOOT_API_TOKEN
CHATWOOT_ACCOUNT_ID=1

# === Evolution (WhatsApp personal) ===
EVOLUTION_API_URL=https://TU-EVOLUTION.duckdns.org
EVOLUTION_API_KEY=AQUI_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=personal

# === IA / Audio ===
OPENAI_API_KEY=AQUI_OPENAI_API_KEY
GROQ_API_KEY=AQUI_GROQ_API_KEY
FISH_AUDIO_API_KEY=AQUI_FISH_AUDIO_API_KEY

# === Cerebro ===
CEREBRO_API_SECRET=AQUI_CEREBRO_API_SECRET
ADMIN_SECRET=AQUI_ADMIN_SECRET

# === Migración a otro Supabase (solo se usan en scripts/migrar-supabase.mjs) ===
# SUPABASE_ORIGEN_URL=https://VIEJO.supabase.co
# SUPABASE_ORIGEN_KEY=AQUI_SERVICE_ROLE_VIEJO
# SUPABASE_DESTINO_URL=https://NUEVO.supabase.co
# SUPABASE_DESTINO_KEY=AQUI_SERVICE_ROLE_NUEVO
# DATABASE_URL_DESTINO=postgresql://postgres.NUEVO_REF:PASS@db.NUEVO_REF.supabase.co:5432/postgres
# MIGRAR_TABLAS=clientes,conversaciones,mensajes,pagos,tareas
# BATCH_MIGRAR=500
