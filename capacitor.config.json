{
  "appId": "com.templomistico.crm",
  "appName": "Templo Místico CRM",
  "webDir": "out",
  "server": {
    "url": "https://templo-mistico-crm.vercel.app",
    "cleartext": true,
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#090d16"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#090d16"
    },
    "LocalNotifications": {
      "smallIcon": "ic_launcher_foreground",
      "iconColor": "#8b5cf6"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
