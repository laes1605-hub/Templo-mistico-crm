# Copia este archivo como `.env` y rellénalo.
# Llaves generadas con: openssl rand -hex 32  (y -hex 16 para la contraseña)

# Dominios (deben tener registro A apuntando a la IP del VPS)
N8N_DOMINIO=n8n.tudominio.com
CHATWOOT_DOMINIO=chat.tudominio.com

# Postgres de Chatwoot
POSTGRES_PASSWORD=PEGA_AQUI_EL_HEX_16

# Llaves internas (no las compartas; si cambian, n8n pierde las credenciales guardadas)
CHATWOOT_SECRET_KEY_BASE=PEGA_AQUI_EL_HEX_32_1
N8N_ENCRYPTION_KEY=PEGA_AQUI_EL_HEX_32_2
